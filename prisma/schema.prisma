// Prisma schema — models are added here as endpoints are defined.
// After editing, run: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  budget    String?
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model JobApplication {
  id            String   @id @default(cuid())
  jobSlug       String
  role          String
  name          String
  email         String
  phone         String
  location      String
  address       String
  link          String
  resumeUrl     String
  introVideoUrl String
  message       String
  ip            String?
  createdAt     DateTime @default(now())

  @@index([jobSlug])
  @@index([createdAt])
}
