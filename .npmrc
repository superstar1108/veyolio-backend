# Settings that make npm install reliable on VPNs / unstable connections.
# Fewer parallel connections: VPNs often reset connections when too many open at once
maxsockets=3
# Retry dropped downloads with longer waits instead of failing immediately
fetch-retries=6
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=600000
# Reuse packages already downloaded on a previous attempt
prefer-offline=true
# Skip extra network calls that aren't needed for installing
audit=false
fund=false
update-notifier=false
