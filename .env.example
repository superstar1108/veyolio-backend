# Copy to .env and fill in
NODE_ENV=development
PORT=4000

# Local Postgres (see docker-compose.yml) or a hosted one (Neon / Supabase)
DATABASE_URL="postgresql://vertexa:vertexa@localhost:5432/vertexa?schema=public"

# Comma-separated list of origins allowed to call the API (your Next.js site)
CORS_ORIGINS=http://localhost:3000
